# Coach login (Phase 0 — local cookie auth)
JOB_SEARCH_COACH_EMAIL=tim@thequietachievr.com
JOB_SEARCH_COACH_PASSWORD=changeme
JOB_SEARCH_AUTH_SECRET=replace-with-long-random-string

# Job Discovery Bot / Cursor / ICP ingest (Bearer token)
JOB_SEARCH_INGEST_TOKEN=replace-with-long-random-token

# Notion — Allocate → Opportunities + ICP → Prospects
# Share each client's Opportunities DB and the Prospects DB with this integration.
NOTION_INTEGRATION_TOKEN=
NOTION_PROSPECTS_DATABASE_ID=40141716da288058a328fd115350eddd

# Supabase durable store (production / shared). When unset, uses .data/job-search.json.
# Free-tier: js_* tables live on the Notion 30habits30days project until a dedicated project is available.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
